{
  "name": "trading-bots",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply trading-desk --remote",
